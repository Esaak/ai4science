    content: #!/usr/bin/env python3
"""Посчитать метрики качества и сохранить в results/."""
import json
import sys
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parent))
from src.metrics import metrics

ROOT = Path(__file__).resolve().parent
DATA = ROOT / "data" / "edison_cache" / "top_fields.npz"
TABLE = ROOT / "data" / "edison_cache" / "val.npz"
RESULTS_DIR = ROOT / "results"
RESULTS_DIR.mkdir(exist_ok=True)

LAYERS = ["Z1", "Z5", "Z8", "Z25", "Mean"]
MODELS = ["p_combo", "p_прежняя"]

z = np.load(DATA, allow_pickle=True)
v = np.load(TABLE, allow_pickle=True)

idx = z["idx"]
t = z["t"].astype(np.float64)  # (5, 5, 128, 128)
preds = {m: z[m].astype(np.float64) for m in MODELS}

# Определить семейства
campaigns = v["campaign"][idx]
families = np.where(np.char.startswith(campaigns, "2026_01"), "январские", "urban_layer")

rows = []

for m in MODELS:
    p = preds[m]

    # 1. Всё
    r = metrics(t, p)
    r["n"] = int(t.size)
    r["модель"] = m
    r["разрез"] = "всё"
    rows.append(r)

    # 2. По слоям
    for li, layer in enumerate(LAYERS):
        r = metrics(t[:, li], p[:, li])
        r["n"] = int(t[:, li].size)
        r["модель"] = m
        r["разрез"] = f"слой {layer}"
        rows.append(r)

    # 3. По семействам
    for fam in ("январские", "urban_layer"):
        sel = families == fam
        r = metrics(t[sel], p[sel])
        r["n"] = int(t[sel].size)
        r["модель"] = m
        r["разрез"] = f"семейство {fam}"
        rows.append(r)

# Сохранить JSON
out = {"метрики": rows}
json_path = RESULTS_DIR / "metrics.json"
json_path.write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding="utf-8")
print(f"Сохранено {len(rows)} записей в {json_path}")

# Сохранить таблицу Markdown
md_path = RESULTS_DIR / "metrics_table.md"
with md_path.open("w", encoding="utf-8") as f:
    f.write("| модель | разрез | R² | FAC2 | NMSE | FB | mass_ratio | n |\n")
    f.write("|---|---|---|---|---|---|---|---|\n")
    for r in rows:
        f.write(
            f"| {r['модель']} | {r['разрез']} "
            f"| {r['R2']:.6f} | {r['FAC2']:.6f} "
            f"| {r['NMSE']:.6f} | {r['FB']:.6f} "
            f"| {r['mass_ratio']:.6f} | {r['n']} |\n"
        )
print(f"Сохранена таблица в {md_path}")

# Вывести таблицу
print()
for r in rows:
    print(f"  {r['модель']:12s} | {r['разрез']:20s} | R²={r['R2']:+.4f}  FAC2={r['FAC2']:.4f}  NMSE={r['NMSE']:.4f}  FB={r['FB']:+.4f}  mass_ratio={r['mass_ratio']:.4f}  n={r['n']}")


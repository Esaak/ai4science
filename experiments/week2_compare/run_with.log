    content: #!/usr/bin/env python3
"""Расчёт метрик по пяти сценам и запись результатов."""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import numpy as np
from src.metrics import metrics

ROOT = Path(__file__).resolve().parent
DATA = ROOT / "data" / "edison_cache" / "top_fields.npz"
TABLE = ROOT / "data" / "edison_cache" / "val.npz"
RESULT = ROOT / "results" / "metrics.json"
MD = ROOT / "results" / "metrics_table.md"

LAYERS = ["Z1", "Z5", "Z8", "Z25", "Mean"]
MODELS = ["p_combo", "p_прежняя"]

# Загрузка данных
z = np.load(DATA, allow_pickle=True)
v = np.load(TABLE, allow_pickle=True)
idx = z["idx"]
t = z["t"].astype(np.float64)
preds = {m: z[m].astype(np.float64) for m in MODELS}

# Семейства сцен
families = np.where(np.char.startswith(v["campaign"][idx], "2026_01"), "январские", "urban_layer")

rows = []

for model in MODELS:
    p = preds[model]

    # 1. "всё" — все слои, все сцены
    rows.append({
        "модель": model,
        "разрез": "всё",
        "n": int(t.size),
        **metrics(t, p),
    })

    # 2. По слоям
    for li, layer in enumerate(LAYERS):
        rows.append({
            "модель": model,
            "разрез": f"слой {layer}",
            "n": int(t[:, li].size),
            **metrics(t[:, li], p[:, li]),
        })

    # 3. По семействам
    for fam in ("январские", "urban_layer"):
        sel = families == fam
        rows.append({
            "модель": model,
            "разрез": f"семейство {fam}",
            "n": int(t[sel].size),
            **metrics(t[sel], p[sel]),
        })

# Запись JSON
result = {"данные": str(DATA), "метрики": rows}
RESULT.parent.mkdir(parents=True, exist_ok=True)
RESULT.write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding="utf-8")
print(f"Записано {RESULT}")

# Генерация Markdown-таблиц
lines = []
for model in MODELS:
    lines.append(f"## Модель: `{model}`\n")
    lines.append("| разрез | n | R2 | FAC2 | NMSE | FB | mass_ratio |")
    lines.append("|---|---|---|---|---|---|---|")
    for r in rows:
        if r["модель"] != model:
            continue
        vals = [f"{r[k]:.6g}" for k in ["R2", "FAC2", "NMSE", "FB", "mass_ratio"]]
        lines.append(f"| {r['разрез']} | {r['n']} | {' | '.join(vals)} |")
    lines.append("")

MD.write_text("\n".join(lines), encoding="utf-8")
print(f"Записано {MD}")
print("Готово.")

